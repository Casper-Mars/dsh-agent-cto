{
  "name": "dsh-agent-cto",
  "version": "0.8.0",
  "type": "module",
  "description": "技术决策者：决策、设计、评审、治理与任务拆解",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "cto",
    "domain"
  ],
  "author": "Casper <solitaryreach@163.com>",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.7.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "main": "dist-server/index.js",
  "exports": {
    ".": {
      "types": "./dist-server/types/index.d.ts",
      "default": "./dist-server/index.js"
    },
    "./assets": {
      "types": "./dist-server/types/assets.d.ts",
      "default": "./dist-server/assets.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./assets/designer": {
      "types": "./dist-server/types/assets-designer.d.ts",
      "default": "./dist-server/assets-designer.js"
    }
  },
  "files": [
    "dist-server/**/*.js",
    "dist-server/types/**/*.d.ts",
    "dist-server/**/*.md",
    "dist-server/cordis.patch.yml",
    "scripts/verify-install.mjs",
    "skills/",
    "cordis.patch.yml",
    "design-kit/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm clean && pnpm typecheck && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "build:server": "pnpm clean && tsc -p tsconfig.server.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify:install": "node scripts/verify-install.mjs",
    "clean": "rm -rf dist dist-server",
    "prepublishOnly": "pnpm build",
    "compat": "bash scripts/dsh-compat.sh",
    "design:validate": "node design-kit/scripts/validate-tokens.mjs",
    "design:css": "node design-kit/scripts/tokens-to-css.mjs",
    "design:template": "node design-kit/scripts/build-template-tokens.mjs",
    "design:shots": "node design-kit/scripts/screenshot.mjs",
    "design:check": "node design-kit/scripts/check.mjs",
    "design:sync": "node design-kit/scripts/sync-to-one.mjs",
    "design:drift": "node design-kit/scripts/check-drift.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-filesystem": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  }
}
